# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local or real credentials to git.
# Placeholder values below are treated as "not configured".

# Optional: Supabase accounts + cloud save. Leave as-is for local-only mode.
# A saved snapshot holds parsed dashboard data: follower/following lists, DM thread
# names and participants, up to 100 sampled messages per thread (emails/phones
# masked), top search terms, LinkedIn Helper notes and AI summaries. It never holds
# the ZIP, media, full message histories, or login IP addresses/locations/devices.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: AI summaries and chat (server-side only, OpenAI-compatible API).
# DM summaries send up to 100 sampled messages from one thread when the user
# clicks Generate; the overview recap and chat send aggregate counts only.
AI_API_KEY=your_ai_provider_key
AI_MODEL=your_model_name
AI_BASE_URL=optional_provider_base_url

# Optional: school name for LinkedIn Google searches (e.g. Northeastern University)
NEXT_PUBLIC_LINKEDIN_SCHOOL_CONTEXT=
